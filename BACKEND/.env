#system configurations
PORT=3000  #the port on which the server listens

#postgreSQL database config
PGHOST=localhost  #network address and port where SQL is running
PGPORT=5432
PGUSER=aigit_postgres  #account credentials
PGPASSWORD=aigiteam
PGDATABASE=aigit_db  #database ka naam in which we will store the commits, trees, etc

#minIo object storage config
MINIO_ENDPOINT=localhost  #access point for minio server
MINIOPORT=9000
MINIO_USE_SSL=false  #false for now but https incorporate karne ke baad we will put true
MINIO_ACCESS_KEY=aigit_minio  #administrative access
MINIO_SECRET_KEY=aigiteam  #password for access key
MINIO_BUCKET_NAME=aigit-chunks  #the specific bucket where raw binaries are saved